@startuml
start

:Receber dados do usuário;
:Tipo de imóvel, quartos, filhos, vagas, parcelar;

if (Tipo de imóvel válido?) then (sim)
  :Criar objeto Imovel correspondente;
  
  if (Tipo == Apartamento?) then (sim)
    :Calcular aluguel base R$ 700;
    if (quartos == 2?) then (sim)
      :Adicionar R$ 200;
    else (não)
    endif
    if (sem filhos?) then (sim)
      :Aplicar desconto de 5%;
    else (não)
    endif
  else (não)
    if (Tipo == Casa?) then (sim)
      :Calcular aluguel base R$ 900;
      if (quartos == 2?) then (sim)
        :Adicionar R$ 250;
      else (não)
      endif
    else (não)
      if (Tipo == Estúdio?) then (sim)
        :Calcular aluguel base R$ 1.200;
        if (vagas > 0?) then (sim)
          :Calcular garagem;
          if (vagas == 2?) then (sim)
            :R$ 250,00;
          else (mais de 2)
            :R$ 250 + R$ 60 por vaga extra;
          endif
        else (sem vagas)
        endif
      else (inválido)
        :Exibir erro;
      endif
    endif
  endif
  
  if (parcelar?) then (sim)
    :Calcular parcela da taxa de contrato (até 5x);
  else (não)
    :Taxa de contrato R$ 2.000,00 à vista;
  endif
  
  :Calcular valor total mensal;
  :Gerar arquivo .csv com 12 parcelas;
  :Exibir resumo;
else (não)
  :Exibir erro de entrada;
endif

stop
@enduml