@startuml
skinparam componentFontSize 12
skinparam componentAttributeFontSize 11
skinparam nodeFontSize 11
skinparam rectangleFontSize 11
skinparam defaultTextAlignment left
skinparam wrapWidth 300
skinparam componentStyle uml2

title Arquitetura de Software — Orçamento de Aluguel R.M
title para 10 usuários simultâneos

node "Cliente\n(Navegador Web)" as client {
  component "Interface\n(HTML/CSS/JS)" as view
}

node "Servidor\n(Nginx)" as nginx {
  component "Reverse Proxy\n(Load Balancer)" as lb
}

node "Aplicação\n(Gunicorn + Flask)" as app {
  component "Camada de Visão\n(Flask Templates)" as flask_view
  component "Camada de Controle\n(Flask Routes)" as controller
  component "Camada de Modelo\n(Python Classes)" as model {
    component "Imovel (ABC)" as imovel
    component "Apartamento" as apt
    component "Casa" as casa
    component "Estudio" as est
    component "Locatario" as loc
    component "Orcamento" as orc
  }
  component "Camada de Persistência\n(SQLAlchemy ORM)" as persistence
}

node "Banco de Dados\n(SQLite)" as db {
  component "Orçamento DB" as sqlite
}

client --> view : HTTP GET/POST
view --> flask_view : Requisição HTML
flask_view --> controller : Roteamento
controller --> model : Instancia & calcula
controller --> persistence : Salva/Busca
persistence --> sqlite : SQL queries
sqlite --> persistence : Resultados
persistence --> controller : Dados ORM
controller --> flask_view : Dados para renderização
flask_view --> view : HTML renderizado
view --> client : Resposta visual

note right of nginx
  Nginx distribui as requisições\nentre instâncias do Gunicorn\npara suportar 10 usuários simultâneos
end note

note bottom of sqlite
  SQLite em modo WAL\npara leitura concorrente\nadequado para 10 usuários leves
end note

note left of model
  POO com herança polimórfica:\nImovel → Apartamento/Casa/Estudio\nCálculos encapsulados em cada classe
end note

@enduml