{"dashboard": {"id": null, "uid": "orcamento-nfr", "title": "Orçamento R.M — NFR Monitoring", "tags": ["orcamento", "nfr", "swebook"], "timezone": "browser", "schemaVersion": 16, "version": 0, "refresh": "5s", "panels": [{"id": 1, "title": "Request Duration (P50/P95/P99)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "histogram_quantile(0.50, rate(app_request_duration_seconds_bucket[5m]))", "legendFormat": "P50", "refId": "A"}, {"expr": "histogram_quantile(0.95, rate(app_request_duration_seconds_bucket[5m]))", "legendFormat": "P95", "refId": "B"}, {"expr": "histogram_quantile(0.99, rate(app_request_duration_seconds_bucket[5m]))", "legendFormat": "P99", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0, "max": 10, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1.0}]}}}}, {"id": 2, "title": "Request Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "rate(app_request_total[5m])", "legendFormat": "{{method}} {{endpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}}, {"id": 3, "title": "Error Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "rate(app_error_total[5m])", "legendFormat": "{{error_type}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}}}}, {"id": 4, "title": "Calculation Duration by Property Type", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, rate(app_calculation_duration_seconds_bucket[5m]))", "legendFormat": "{{property_type}} P95", "refId": "A"}, {"expr": "histogram_quantile(0.50, rate(app_calculation_duration_seconds_bucket[5m]))", "legendFormat": "{{property_type}} P50", "r