Enum tipo_imovel {
  APARTAMENTO
  CASA
  ESTUDIO
}

Enum status_parcelamento {
  A_VISTA
  PARCELADO
}

Table imovel {
  id int [pk]
  tipo tipo_imovel [not null]
  endereco varchar(255)
  quartos int
  vagas_garagem int
}

Table tabela_preco {
  id int [pk]
  tipo tipo_imovel [not null, unique]
  valor_base decimal(10,2) [not null]
  acrescimo_dois_quartos decimal(10,2)
  desconto_sem_filhos decimal(3,2)
  garagem_valor_fixo decimal(10,2)
  garagem_valor_extra decimal(10,2)
  taxa_contrato decimal(10,2)
}

Table orcamento {
  id int [pk]
  imovel_id int [not null, ref: > imovel.id]
  tabela_preco_id int [not null, ref: > tabela_preco.id]
  tem_filhos boolean [not null, default: false]
  parcelar boolean [not null, default: false]
  num_parcelas_contrato int
  aluguel_base decimal(10,2) [not null]
  valor_acrescimos decimal(10,2) [not null, default: 0]
  valor_desconto decimal(10,2) [not null, default: 0]
  valor_garagem decimal(10,2) [not null, default: 0]
  taxa_contrato decimal(10,2) [not null, default: 0]
  valor_total_mensal decimal(10,2) [not null]
  parcela_contrato decimal(10,2) [not null, default: 0]
  status status_parcelamento [not null]
  criado_em timestamp [not null]
}

Table parcela_orcamento {
  id int [pk]
  orcamento_id int [not null, ref: > orcamento.id]
  numero int [not null]
  valor decimal(10,2) [not null]
}